# Define all of our base paths up-front
set port_install_prefix \
                    ${prefix}/libexec/${name}
set port_install_cmake \
                    ${port_install_prefix}/cmake
set port_install_include \
                    ${port_install_prefix}/include
set port_install_lib \
                    ${port_install_prefix}/lib

# Populate CMake options currently available
cmake.install_prefix \
                    ${port_install_prefix}
cmake_share_module_dir \
                    ${port_install_cmake}
cmake.install_rpath \
                    ${port_install_lib}

configure.args-append  -DOmega_h_USE_MPI:BOOL=ON \
                       -DCMAKE_CXX_COMPILER:FILEPATH=${prefix}/bin/mpicxx \
                       -DOmega_h_USE_Gmsh_DEFAULT:BOOL=ON \
                       -DOmega_h_USE_Gmsh:BOOL=ON \
                       -DCMAKE_CXX_FLAGS=-O3

